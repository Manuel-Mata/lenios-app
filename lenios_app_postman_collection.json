{
  "info": {
    "_postman_id": "8a32b91d-4f12-4c89-9a73-lenios-rellenos-lgpdppso",
    "name": "Leños Rellenos - Pruebas API & Derechos ARCO (LGPDPPSO)",
    "description": "Colección de pruebas automatizadas para la API REST de Leños Rellenos, cubriendo gestión de pedidos, seguridad de sesiones, control de acceso por roles, derechos ARCO y trazabilidad de auditoría conforme a la LGPDPPSO.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "currentOrderId",
      "value": "LR-10821",
      "type": "string"
    },
    {
      "key": "arcoUserId",
      "value": "user-client-01",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Autenticación",
      "item": [
        {
          "name": "0.1 Login Administrador (Obtener Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Respuesta no expone hashes ni contraseñas', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user).to.not.have.property('password');",
                  "    pm.expect(jsonData.user).to.not.have.property('hash');",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('adminToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@lenios.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "0.2 Login Cliente (Obtener Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('clientToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@lenios.com\",\n  \"password\": \"cliente123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Gestión de Pedidos (Criterios 1, 2, 3)",
      "item": [
        {
          "name": "1.1 POST /api/orders — Crear Pedido (Asociado al Cliente & Minimizado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Pedido contiene ID y totales válidos calculados en servidor', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.order).to.have.property('id');",
                  "    pm.expect(jsonData.order.subtotal).to.be.above(0);",
                  "    pm.expect(jsonData.order.total).to.be.above(0);",
                  "    pm.collectionVariables.set('currentOrderId', jsonData.order.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Carlos Rodríguez\",\n  \"customerPhone\": \"4731234567\",\n  \"deliveryType\": \"delivery\",\n  \"customerAddress\": \"Calle Artesanal #12, Guanajuato\",\n  \"paymentMethod\": \"cash\",\n  \"notes\": \"Tocar timbre dos veces\",\n  \"items\": [\n    {\n      \"id\": \"leno-arrachera\",\n      \"quantity\": 2,\n      \"customization\": \"Base Rústica\",\n      \"extraPrice\": 8\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "1.2 GET /api/orders/:id — Obtener Pedido por ID (Propietario o Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Responde con la estructura correcta del pedido', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.order.id).to.eql(pm.collectionVariables.get('currentOrderId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}"]
            }
          }
        },
        {
          "name": "1.3 PUT /api/orders/:id/status — Actualizar Estado (Solo Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Estado de orden actualizado a in_oven', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.order.status).to.eql('in_oven');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_oven\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Panel Administrativo & ARCO (Criterios 4, 5, 6, 7)",
      "item": [
        {
          "name": "2.1 GET /api/admin/orders — Lista Todos los Pedidos (Solo Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK para Admin', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Lista contiene colección de órdenes', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.orders).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders"]
            }
          }
        },
        {
          "name": "2.2 DELETE /api/users/:id — Lógica ARCO (Elimina / Anonimiza Datos Personales)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK para Derecho ARCO', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Confirmación de anonimización LGPDPPSO', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.details.status).to.eql('ANONYMIZED_AND_DELETED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{arcoUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{arcoUserId}}"]
            }
          }
        },
        {
          "name": "2.3 GET /api/admin/audit-logs — Trazabilidad de Auditoría (Quién, Cuándo, Para Qué)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Logs registran quién, cuándo y propósito', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.auditLogs).to.be.an('array');",
                  "    pm.expect(jsonData.auditLogs.length).to.be.above(0);",
                  "    const log = jsonData.auditLogs[0];",
                  "    pm.expect(log).to.have.property('who');",
                  "    pm.expect(log).to.have.property('when');",
                  "    pm.expect(log).to.have.property('action');",
                  "    pm.expect(log).to.have.property('purpose');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "audit-logs"]
            }
          }
        }
      ]
    }
  ]
}
